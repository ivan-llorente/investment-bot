# Modo de operación: paper | live
MODE=paper

# Puerto del webhook server
PORT=8080

# Secreto compartido con TradingView. Inclúyelo en el JSON de la alerta
# como "secret":"..." para validar que la alerta viene de tu cuenta de TV.
# Genera uno con: openssl rand -hex 32
WEBHOOK_SECRET=changeme

# Credenciales de Crypto.com (solo necesarias si MODE=live)
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
