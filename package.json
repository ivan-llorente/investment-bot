{
  "name": "investment-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:integration && npm run test:bdd",
    "test:integration": "vitest run",
    "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "ccxt": "^4.4.40",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
